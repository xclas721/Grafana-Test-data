# =============================================================================
# DDoS 限流測試
# =============================================================================
#
# --- Dev proxy ---
# Local（npm run dev）：未設定時預設 localhost:30100 / 8050
# Remote（npm run dev:remote）：必須在 .env.remote 指定目標，否則啟動失敗
#
# VITE_TARGET_ENV=local
# VITE_PROXY_ACS_AUTH_TARGET=http://localhost:30100
# VITE_PROXY_ACS_AUTH_WEB_TARGET=http://localhost:8050
#
# --- 建置期 API origin（可選；留空＝相對路徑走 proxy／nginx）---
# VITE_ACS_AUTH_BASE=http://your-domain:30100
# VITE_ACS_AUTH_WEB_BASE=http://your-domain:8050
#
# --- nginx 反代（部署）---
#   location /acs-auth { proxy_pass http://backend:30100; }
#   location /acs-auth-web { proxy_pass http://acs-auth-web:8050; }
#
# 測資／ES bulk 僅供本機假資料，請勿接到 Remote。
